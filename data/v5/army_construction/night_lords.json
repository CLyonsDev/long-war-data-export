 "rites_of_war": [
  {
   "id": "codex/night_lords/rites_of_war/night_lords_claw_company",
   "name": "Night Lords 'Claw' Company",
   "page": 10,
   "url": "https://longwarindex.app/rites_of_war/night_lords_claw_company/",
   "offered_by": {
    "allegiance": "codex/night_lords/allegiances/allegiance_night_lords"
   },
   "text": "Requirements\n\n- Your army must include at least 1 Chaos Lord.\n- Each Infantry unit in your army that does not have the Character special rule must include at least 10 models in each unit.\n- Your army must contain more Infantry units that Vehicle units.\n\nBenefits\n\n- Night Fighting is automatically in effect this battle, even if your Battle Pack does not include Night Fighting. You may determine if its Dawn or Dusk. If your opponent can also force Night Fighting, roll off to determine who will select the type of Night Fighting effect this battle.\n- You may field Night Raptors as Troops choices.\n- You may gain 1 additional Flyer Slot per 1,000pts.\n- Any Infantry unit in your army which contains 10 or more models may purchase Trophies of Judgement for 15pts.",
   "restrictions": [
    {
     "id": "chaos_lord_unit",
     "printed": "Your army must include at least 1 Chaos Lord.",
     "scope": "detachment",
