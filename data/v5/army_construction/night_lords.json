  {
   "id": "codex/night_lords/rites_of_war/the_first_claw",
   "name": "The First Claw",
   "page": 12,
   "url": "https://longwarindex.app/rites_of_war/the_first_claw/",
   "offered_by": {
    "allegiance": "codex/night_lords/allegiances/allegiance_night_lords"
   },
   "text": "Requirements\n\n- Your army must include either:\n    - Vandred Anrathi, the Exalted.\n    - Or Talos Valcoran, The Soul Hunter.\n- Your army may not include Krieg Acerbus or Decimus, Prophet of the 8th Legion.\n- Your army must include at least 1 unit of Atramentar.\n\nBenefits\n\n- Units in your army with the Deep Strike special rule may re-roll the result when determining of they will arrive and scatter.\n- You may field Storm Eagle Gunships as a Dedicated Transport.\n- You may field 1 Atramentar unit without taking up a Force Organization Slot which does not count towards the Limit: 1 Per Detachment special rule of the unit.",
   "restrictions": [
    {
     "id": "vandred_or_talos",
     "printed": "Your army must include either:",
     "scope": "detachment",
     "units": {
      "conditions": [
       {
        "any_of": [
         {
          "datasheet": "codex/night_lords/roster/vandred_anrathi_the_exalted"
         },
         {
          "datasheet": "codex/night_lords/roster/talos_valcoran_the_soul_hunter"
         }
        ]
       }
      ],
      "min": 1
     }
    },
    {
     "id": "no_krieg_or_decimus",
     "printed": "Your army may not include Krieg Acerbus or Decimus, Prophet of the 8th Legion.",
     "scope": "detachment",
