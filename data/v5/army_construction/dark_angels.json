 "rites_of_war": [
  {
   "id": "codex/dark_angels/rites_of_war/deathwing_strike_talon",
   "name": "Deathwing Strike Talon",
   "page": 14,
   "url": "https://longwarindex.app/rites_of_war/deathwing_strike_talon/",
   "offered_by": {
    "allegiance": "codex/dark_angels/allegiances/allegiance_dark_angels"
   },
   "text": "Restrictions\n\n- All units in your army must have the Veteran keyword or the Inner Circle special rule.\n- Your Warlord must be a Space Marine Captain upgraded to a Deathwing Strike Master or Belial, Master of the Deathwing.\n\nBenefits\n\n- You may field Deathwing Terminators as Troops choices.\n- Deathwing Knights become Limited: 2 per detachment.\n- You gain access to the following units (see below):\n    - Deathwing Command Squad.",
   "restrictions": [
    {
     "id": "veteran_or_inner_circle",
     "printed": "All units in your army must have the Veteran keyword or the Inner Circle special rule.",
     "scope": "detachment",
     "every_unit": {
      "must": [
       {
        "any_of": [
         {
          "keyword": "Veteran"
         },
         {
          "rule": {
           "rule": "codex/dark_angels/special_rules/inner_circle",
           "name": "Inner Circle",
           "url": "https://longwarindex.app/special_rules/inner_circle/"
          }
         }
        ]
       }
      ]
     }
    },
    {
     "id": "warlord_strike_master_or_belial",
     "printed": "Your Warlord must be a Space Marine Captain upgraded to a Deathwing Strike Master or Belial, Master of the Deathwing.",
     "scope": "detachment",
     "warlord": {
      "conditions": [
