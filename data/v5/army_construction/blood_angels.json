 "rites_of_war": [
  {
   "id": "codex/blood_angels/rites_of_war/airborne_assault",
   "name": "Airborne Assault",
   "page": 15,
   "url": "https://longwarindex.app/rites_of_war/airborne_assault/",
   "offered_by": {
    "allegiance": "codex/blood_angels/allegiances/allegiance_blood_angels"
   },
   "text": "Restrictions\n\n- Your army must include at least 2 Aircraft type units.\n- Infantry, Bike or Cavalry type units that do not have the Fly or Infiltrate special rule must begin the game in Reserves or Embarked on a Transport.\n- Vehicle type units in your army must begin the game in Reserves.\n- Walker type units in your army that do not have the Infiltrate special rule must begin the game in Reserves or Embarked on a Transport.\n\nBenefits\n\n- You may field Stormtalon Gunships as Heavy Support choices.\n- You may field Stormraven Gunships as Dedicated Transports.\n- You may field Assault Marines as Troops choices.\n- All units in your army that do not have the Fly or Infiltrate special rule may be placed in reserves. They may arrive via the Outflank special rule but may only enter on the board within your deployment zone.",
   "restrictions": [
    {
     "id": "aircraft_min",
     "printed": "Your army must include at least 2 Aircraft type units.",
     "scope": "detachment",
     "units": {
      "conditions": [
       {
        "unit_type": "Aircraft"
       }
      ],
      "min": 2
     }
    }
   ],
   "benefits": [
    {
     "id": "stormtalon_heavy_support",
