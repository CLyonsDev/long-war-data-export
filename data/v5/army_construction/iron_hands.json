 "rites_of_war": [
  {
   "id": "codex/iron_hands/rites_of_war/ancient_bulwark",
   "name": "Ancient Bulwark",
   "page": 13,
   "url": "https://longwarindex.app/rites_of_war/ancient_bulwark/",
   "offered_by": {
    "allegiance": "codex/iron_hands/allegiances/allegiance_iron_hands"
   },
   "text": "Restrictions\n\n- Your army must include at least 1 Walker type unit per 1,000pts.\n- Your army must include at least 1 Firestrike Servo Turret or Space Marine Lieutenant upgraded to be a Tech-Marine with a Thunderfire cannon.\n- If you do not have a unit in your Deployment Zone at the end of the battle, you lose 1VP.\n\nBenefits\n\n- You may field Castaferrum Dreadnoughts as Troops choices, but they gain the Support Squad special rule.\n- You may field Redemptor Dreadnoughts as Troops choices, but they gain the Support Squad special rule.\n- You may field 1 Redemptor Dreadnought, Contemptor Dreadnought or Castraferrum Dreadnought in your army as a HQ choice. The unit gains the Character special rule and must be your Warlord.",
   "restrictions": [
    {
     "id": "firestrike_or_thunderfire_tech_marine",
