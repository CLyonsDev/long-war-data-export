 "rites_of_war": [
  {
   "id": "codex/imperial_agents/rites_of_war/deathwatch_kill_force",
   "name": "Deathwatch Kill Force",
   "page": 31,
   "url": "https://longwarindex.app/rites_of_war/deathwatch_kill_force/",
   "offered_by": {
    "codex": "imperial_agents"
   },
   "text": "Restrictions\n\n- Your army must include at least 3 Deathwatch Kill Team unit.\n- Your army must include at least 1 Watch Captain unit.\n- Your army must be Allegiance: Ordo Xenos.\n\nBenefit\n\n- Ignore the Support Squad special rule on Deathwatch Kill Team units in your army.\n- Ignore the Support Squad special rule on Watch Captain units in your army.\n- You gain access to the below Warlord Traits instead of the standard Imperial Agents Warlord traits.\n- You gain access to the below Relic Wargear.\n- You gain access to the following units (see below):\n    - Watch Captain Artemis.\n\nRelic Wargear\n\n- The Spear of the First Vigil\n\nWarlord Traits\n\n- Castellan of the Black Vault\n- Paragon of their Chapter\n- The Ties that Bind",
   "restrictions": [
    {
     "id": "deathwatch_kill_force_kill_team_min",
     "printed": "Your army must include at least 3 Deathwatch Kill Team unit.",
     "scope": "detachment",
     "units": {
      "conditions": [
       {
        "datasheet": "codex/imperial_agents/roster/deathwatch_kill_team"
       }
      ],
      "min": 3
     }
    },
    {
     "id": "deathwatch_kill_force_watch_captain_min",
     "printed": "Your army must include at least 1 Watch Captain unit.",
     "scope": "detachment",
     "units": {
      "conditions": [
       {
        "any_of": [
         {
          "datasheet": "codex/imperial_agents/roster/watch_captain"
         },
         {
          "datasheet": "codex/imperial_agents/roster/watch_captain_artemis"
         }
        ]
       }
      ],
      "min": 1
     }
    },
    {
     "id": "deathwatch_kill_force_allegiance",
     "printed": "Your army must be Allegiance: Ordo Xenos.",
     "scope": "detachment",
     "every_unit": {
      "must": [
       {
        "allegiance": "codex/imperial_agents/allegiances/ordo_of_xenos"
       }
      ]
     }
    },
    {
     "id": "deathwatch_kill_force_warlord_traits_forbidden",
     "printed": "You gain access to the below Warlord Traits instead of the standard Imperial Agents Warlord traits.",
