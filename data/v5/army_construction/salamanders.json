     "role": {
      "conditions": [
       {
        "datasheet": "codex/space_marines/roster/weapon_support_squad"
       }
      ],
      "role": "Troops",
      "instead": false
     }
    },
    {
     "id": "weapon_support_squads_support_squad",
     "printed": "You may field Weapon Support Squads as Troops choices, but they gain the Support Squad special rule.",
     "rules": {
