 "rites_of_war": [
  {
   "id": "codex/salamanders/rites_of_war/the_covenant_of_fire",
   "name": "The Covenant of Fire",
   "page": 12,
   "url": "https://longwarindex.app/rites_of_war/the_covenant_of_fire/",
   "offered_by": {
    "allegiance": "codex/salamanders/allegiances/allegiance_salamanders"
   },
   "text": "Restrictions\n\n- Your army must include a Space Marine Captain with the Forge Father upgrade.\n- Units in your army may not Deep Strike unless it is via a Drop Pod.\n- You may not include any Fortification type units in your army unless it is a Drop Pod.\n\nBenefits\n\n- You may field Gravis Support Squads as Elites choices.\n- You may field Weapon Support Squads as Troops choices, but they gain the Support Squad special rule.\n- Salamanders' units in your army with the Veteran Keyword gain the Sanctified by Fire special rule (see Special rules Appendix).",
   "restrictions": [
    {
     "id": "captain_with_forge_father",
     "printed": "Your army must include a Space Marine Captain with the Forge Father upgrade.",
     "scope": "detachment",
     "units": {
      "conditions": [
       {
        "datasheet": "codex/space_marines/roster/space_marine_captain"
       },
       {
        "rule": {
         "rule": "codex/salamanders/special_rules/forge_father",
         "name": "Forge Father",
         "url": "https://longwarindex.app/special_rules/forge_father/"
        }
       }
      ],
      "min": 1
     }
    },
    {
     "id": "no_fortifications_except_drop_pod",
     "printed": "You may not include any Fortification type units in your army unless it is a Drop Pod.",
     "scope": "detachment",
     "units": {
      "conditions": [
       {
        "unit_type": "Fortification"
       },
       {
        "not": {
         "datasheet": "codex/space_marines/roster/drop_pod"
        }
       }
      ],
      "max": 0
     }
    }
   ],
   "benefits": [
    {
     "id": "gravis_support_squads_elites",
     "printed": "You may field Gravis Support Squads as Elites choices.",
     "role": {
      "conditions": [
       {
        "datasheet": "codex/space_marines/roster/gravis_support_squad"
