  {
   "id": "codex/dark_eldar/rites_of_war/the_cult_of_strife",
   "name": "The Cult of Strife",
   "page": 23,
   "url": "https://longwarindex.app/rites_of_war/the_cult_of_strife/",
   "offered_by": {
    "codex": "dark_eldar"
   },
   "text": "Restrictions\n\n- Your army may only include units with the Wych Cult or Mercenary Keywords.\n- Your army must include 1 Succubus or Lelith Hesperax. If Lelith Hesperax is in your army, she must be your Warlord.\n- Your army must include 2 Blood Brides units.\n- Wych, Succubus and Blood Bride units in your army may not purchase Combat Drugs.\n\nBenefits\n\n- You may field Blood Brides as Troops choices.\n- Hekatarii Blades equipped by units in your army gain the Rending (6+) special rule.\n- Blood Bride units in your army may include an additional 15 Blood Bride models instead of 5 (max 20 models per unit).",
   "restrictions": [
    {
     "id": "the_cult_of_strife_keywords",
     "printed": "Your army may only include units with the Wych Cult or Mercenary Keywords.",
     "scope": "detachment",
     "every_unit": {
      "must": [
       {
