 "rites_of_war": [
  {
   "id": "codex/craftworld_eldar/rites_of_war/war_host",
   "name": "War Host",
   "page": 28,
   "url": "https://longwarindex.app/rites_of_war/war_host/",
   "offered_by": {
    "codex": "craftworld_eldar"
   },
   "text": "Restrictions:\n\n- Your army must include 1 Autarch or Farseer.\n- A Farseer or Autarch in your army must be your Warlord.\n- Your army must include at least 1 Militia or Engine of Vaul unit for every Aspect Warrior unit in your army.\n\nBenefits:\n\n- You may include an additional Troops slot in your army for every 1000pts.\n- You may field Falcon Grav Tanks as Dedicated Transports.\n- At the start of the first turn, but before any player takes any actions, you may select 3 units in your Army and Re-deploy that unit as if it were the Deployment step of the battle.",
   "restrictions": [
    {
     "id": "war_host_autarch_or_farseer",
     "printed": "Your army must include 1 Autarch or Farseer.",
     "scope": "detachment",
     "units": {
      "conditions": [
       {
        "any_of": [
         {
          "datasheet": "codex/craftworld_eldar/roster/autarch"
         },
         {
          "datasheet": "codex/craftworld_eldar/roster/farseer"
         }
        ]
       }
      ],
      "min": 1
     }
    },
    {
     "id": "war_host_warlord",
     "printed": "A Farseer or Autarch in your army must be your Warlord.",
     "scope": "detachment",
     "warlord": {
      "conditions": [
       {
        "any_of": [
         {
          "datasheet": "codex/craftworld_eldar/roster/farseer"
         },
         {
          "datasheet": "codex/craftworld_eldar/roster/autarch"
