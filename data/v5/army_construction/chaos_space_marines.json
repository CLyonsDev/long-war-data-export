 "rites_of_war": [
  {
   "id": "codex/chaos_space_marines/rites_of_war/chosen_host",
   "name": "Chosen Host",
   "page": 31,
   "url": "https://longwarindex.app/rites_of_war/chosen_host/",
   "offered_by": {
    "codex": "chaos_space_marines"
   },
   "text": "Requirements\n\n- Your army must include at least 2 Chosen units.\n- All Troops choices in your army must have the Terminator or Veteran keyword.\n- If your Warlord is slain, you lose D3 Victory Points at the end of the game.\n\nBenefits\n\n- Any unit with the Terminator or Veteran Keywords may be taken as Troops choices instead of as their regular choice.\n- You can select one Chaos Space Marine Infantry or Cavalry unit that does not have the Veteran keyword to include in your army. It gains the Veteran keyword.\n- While your Warlord is alive, any unit that can draw visibility to your Warlord from your army may use the Warlord's Leadership (LD) characteristic for Pinning and Panic tests.",
   "restrictions": [
    {
     "id": "chosen_units",
     "printed": "Your army must include at least 2 Chosen units.",
     "scope": "detachment",
     "units": {
      "conditions": [
       {
        "datasheet": "codex/chaos_space_marines/roster/chosen"
       }
      ],
      "min": 2
     }
    },
    {
     "id": "troops_terminator_or_veteran",
     "printed": "All Troops choices in your army must have the Terminator or Veteran keyword.",
     "scope": "detachment",
     "every_unit": {
      "of": [
       {
        "role": "Troops"
       }
      ],
      "must": [
       {
        "any_of": [
         {
          "keyword": "Terminator"
         },
         {
          "keyword": "Veteran"
         }
        ]
       }
      ]
     }
    }
   ],
   "benefits": [
