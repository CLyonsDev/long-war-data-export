 "rites_of_war": [
  {
   "id": "codex/iron_warriors/rites_of_war/olympic_grand_company",
   "name": "Olympic Grand Company",
   "page": 10,
   "url": "https://longwarindex.app/rites_of_war/olympic_grand_company/",
   "offered_by": {
    "allegiance": "codex/iron_warriors/allegiances/allegiance_iron_warriors"
   },
   "text": "Requirements\n\n- Your army must include at least 2 units of Inductii.\n- Your army must include at least 1 Chaos Lord.\n- All Legionnaire Squads in your army gain the Support Squad special rule.\n\nBenefits\n\n- Iron Havoc units may be fielded as Elites choices.\n- Inductii units in your army may re-roll 1 dice when making a Pinning test.\n- Rhino APC units in your army may be upgraded to Castellen Rhino APC's for 30pts. A unit with this upgrade gains +1 to its Armour values for its Front Armour (FA) and Side Armour (SA). In addition, the unit increases its Firing Ports (1) special rule to Firing Ports (2).",
   "restrictions": [
