  {
   "id": "codex/talons_of_the_emperor/rites_of_war/the_tharantoi",
   "name": "The Tharantoi",
   "page": 16,
   "url": "https://longwarindex.app/rites_of_war/the_tharantoi/",
   "offered_by": {
    "codex": "talons_of_the_emperor"
   },
   "text": "Restrictions\n\n- All units in your army must have the Custodes Keyword.\n- All Infantry units in your army must have the Terminator Keyword or be Sagittarum Guard.\n- You may not include any Jetbike type units or units with the Fly special rule.\n\nBenefits\n\n- You may field Sagittarum Guard units (see below).\n- You may ignore the Limited: 1 Per Detachment special rule on Allarus Terminator Custodes units in your army.\n- You may field Land Raiders as Dedicated Transports.",
   "restrictions": [
    {
     "id": "the_tharantoi_custodes_keyword",
     "printed": "All units in your army must have the Custodes Keyword.",
     "scope": "detachment",
