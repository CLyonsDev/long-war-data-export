 "rites_of_war": [
  {
   "id": "codex/emperors_children/rites_of_war/cacophonic_orchestra",
   "name": "Cacophonic Orchestra",
   "page": 11,
   "url": "https://longwarindex.app/rites_of_war/cacophonic_orchestra/",
   "offered_by": {
    "allegiance": "codex/emperors_children/allegiances/allegiance_emperors_children"
   },
   "text": "Requirements\n\n- Your army must include at least 3 Noise Marine units.\n- Your army must include a Chaos Lord with the Lord Kakaphonist upgrade.\n- You may not include Fulgrim, Daemon Primarch of the Emperor's Children.\n\nBenefits\n\n- Any model in your army equipped with a Boltgun, Combi-Bolter or Linked Boltgun may exchange it for a Sonic Blaster for 1pts per model.\n- Any model in your army equipped with a Boltpistol may exchange it for a Screamer Pistol for 5pts per model.\n- Any model in your army may exchange their equipped Heavy Bolter or Linked Heavy Bolter for a Linked Sonic Blaster for 0pts.\n- Any model in your army may exchange an Autocannon they are equipped with for a Blastmaster for 0pts.",
   "restrictions": [
    {
     "id": "noise_marine_units",
     "printed": "Your army must include at least 3 Noise Marine units.",
     "scope": "detachment",
     "units": {
      "conditions": [
       {
        "datasheet": "codex/emperors_children/roster/noise_marines"
       }
      ],
      "min": 3
     }
    },
    {
     "id": "lord_kakaphonist",
     "printed": "Your army must include a Chaos Lord with the Lord Kakaphonist upgrade.",
     "scope": "detachment",
     "units": {
      "conditions": [
       {
