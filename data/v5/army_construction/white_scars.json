 "rites_of_war": [
  {
   "id": "codex/white_scars/rites_of_war/chogorian_brotherhood",
   "name": "Chogorian Brotherhood",
   "page": 12,
   "url": "https://longwarindex.app/rites_of_war/chogorian_brotherhood/",
   "offered_by": {
    "allegiance": "codex/white_scars/allegiances/allegiance_white_scars"
   },
   "text": "Restrictions\n\n- Your army must include at least 2 units of Bike Squads.\n- Your Warlord must be a Space Marine Captain.\n- Devastator Squads, Weapon Support Squads and Gravis Support Squads become Limited: 1 Per Detachment.\n- You may not field Fire Strike Servo Turrets and Tech-Marines may not purchase Thunderfire Cannons.\n\nBenefits\n\n- You may field Bike Squads as Troops choices.\n- You may field 1 Attack Bike or Invader ATV unit per Bike Squad in your army without taking up a Force Organization Slot.\n- Veteran Squad units in your army instead of purchasing Jump Packs may purchase Bikes for 5pts per model.",
